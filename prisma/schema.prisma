  referenceType String?
  referenceId   String?
  debitAmount   Decimal  @default(0) @db.Decimal(12, 2)
  creditAmount  Decimal  @default(0) @db.Decimal(12, 2)
  balanceAfter  Decimal  @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime @default(now())
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  @@index([supplierId, createdAt])
}

model SupplierPayment {
  id               String                      @id @default(uuid())
  tenantId         String
  supplierId       String
  paymentReference String?
  paymentMethod    String
  amount           Decimal                     @db.Decimal(12, 2)
  paymentDate      DateTime
  notes            String?
  createdBy        String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  status           SupplierPaymentStatus       @default(COMPLETED)
  user             User?                       @relation(fields: [createdBy], references: [id])
  supplier         Supplier                    @relation(fields: [supplierId], references: [id])
  tenant           Tenant                      @relation(fields: [tenantId], references: [id])
  allocations      SupplierPaymentAllocation[]
}

model SupplierPaymentAllocation {
  id                String          @id @default(uuid())
  tenantId          String
  paymentId         String
  purchaseInvoiceId String
  amount            Decimal         @db.Decimal(12, 2)
  createdAt         DateTime        @default(now())
  payment           SupplierPayment @relation(fields: [paymentId], references: [id])
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  tenant            Tenant          @relation(fields: [tenantId], references: [id])

  @@index([paymentId])
  @@index([purchaseInvoiceId])
}

model SupplierMetrics {
  id                    String   @id @default(uuid())
  supplierId            String   @unique
  averageDeliveryDays   Float    @default(0)
  returnPercentage      Float    @default(0)
  expiryIssuePercentage Float    @default(0)
  qualityScore          Float    @default(100)
  reliabilityScore      Float    @default(100)
  totalOrders           Int      @default(0)
  onTimeDeliveries      Int      @default(0)
  updatedAt             DateTime @updatedAt
  avgExpiryShelfLife    Float    @default(0)
  fulfillmentRate       Float    @default(100)
  pricingStabilityScore Float    @default(100)
  rejectionRate         Float    @default(0)
  supplier              Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId, qualityScore])
  @@index([supplierId, fulfillmentRate])
}

model SupplierReturn {
  id           String               @id @default(uuid())
  tenantId     String
  supplierId   String
  batchId      String?
  quantity     Int?
  reason       String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  status       SupplierReturnStatus @default(PENDING)
  returnAmount Decimal?             @default(0) @db.Decimal(12, 2)
  createdBy    String?
  medicineId   String?
  returnNumber String
  approvedAt   DateTime?
  approvedBy   String?
  pickedUpAt   DateTime?
  notes        String?
  creditNotes  SupplierCreditNote[]
  approver     User?                @relation("SupplierReturnApprover", fields: [approvedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  batch        InventoryBatch?      @relation(fields: [batchId], references: [id])
  creator      User?                @relation("SupplierReturnCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  medicine     Medicine?            @relation(fields: [medicineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier     Supplier             @relation(fields: [supplierId], references: [id])
  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  items        SupplierReturnItem[]

  @@unique([tenantId, returnNumber])
  @@index([tenantId, status])
  @@index([tenantId, supplierId, status])
  @@index([tenantId, createdAt])
}

model SupplierReturnItem {
  id            String         @id @default(uuid())
  returnId      String
  medicineId    String
  batchId       String
  quantity      Int
  expiryDate    DateTime?      @db.Date
  purchasePrice Decimal        @default(0) @db.Decimal(12, 2)
  lossAmount    Decimal        @default(0) @db.Decimal(12, 2)
  reason        String?
  createdAt     DateTime       @default(now())
  batch         InventoryBatch @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  medicine      Medicine       @relation(fields: [medicineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  return        SupplierReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([batchId])
}

model SupplierCreditNote {
  id               String           @id @default(uuid())
  tenantId         String
  supplierId       String
  returnId         String
  creditNoteNumber String
  amount           Decimal          @db.Decimal(12, 2)
  status           CreditNoteStatus @default(ISSUED)
  issuedAt         DateTime         @default(now())
  appliedAt        DateTime?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  return           SupplierReturn   @relation(fields: [returnId], references: [id])
  supplier         Supplier         @relation(fields: [supplierId], references: [id])
  tenant           Tenant           @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, creditNoteNumber])
  @@index([tenantId, status])
  @@index([tenantId, supplierId, status])
}

model PurchaseOrder {
