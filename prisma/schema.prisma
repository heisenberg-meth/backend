  sourceBranch        Branch              @relation("SourceBranch", fields: [sourceBranchId], references: [id])
  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  items               StockTransferItem[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId, status])
}

model StockTransferItem {
  id         String         @id @default(uuid())
  transferId String
  batchId    String
  quantity   Int
  batch      InventoryBatch @relation(fields: [batchId], references: [id])
  transfer   StockTransfer  @relation(fields: [transferId], references: [id])
}

model Supplier {
  id                 String               @id @default(uuid())
  tenantId           String
  supplierCode       String?
  name               String
  contactPerson      String?
  email              String?
  phone              String?
  gstNumber          String?
  drugLicenseNumber  String?
  paymentTermsDays   Int                  @default(30)
  address            String?
  leadTimeDays       Int                  @default(7)
  rating             Float                @default(5.0)
  totalPurchases     Decimal              @default(0) @db.Decimal(12, 2)
  lastPurchaseDate   DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  accountNumber      String?
  bankName           String?
  creditLimit        Decimal              @default(0) @db.Decimal(12, 2)
  ifscCode           String?
  isPreferred        Boolean              @default(false)
  licenseExpiry      DateTime?
  outstandingBalance Decimal              @default(0) @db.Decimal(12, 2)
  drugCategories     String[]
  supplierType       SupplierType         @default(WHOLESALER)
  status             SupplierStatus       @default(ACTIVE)
  inventoryBatches   InventoryBatch[]
  medicineSuppliers  MedicineSupplier[]
  purchaseInvoices   PurchaseInvoice[]
  purchaseOrders     PurchaseOrder[]
  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  creditNotes        SupplierCreditNote[]
