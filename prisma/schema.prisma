  supplierReturns    SupplierReturn[]

  @@unique([tenantId, gstNumber])
  @@unique([tenantId, supplierCode])
  @@index([tenantId, name])
  @@index([tenantId, supplierType])
  @@index([tenantId, status])
  @@index([tenantId, isPreferred])
  @@index([tenantId, deletedAt])
  @@index([licenseExpiry])
}

model MedicineSupplier {
  id                   String    @id @default(uuid())
  medicineId           String
  supplierId           String
  leadDays             Int?      @default(7)
  isPreferred          Boolean   @default(false)
  createdAt            DateTime  @default(now())
  averagePurchasePrice Decimal?  @db.Decimal(12, 2)
  contractPrice        Decimal?  @db.Decimal(12, 2)
