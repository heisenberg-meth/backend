}

model DashboardSnapshot {
  id           String   @id @default(uuid())
  tenantId     String
  branchId     String?
  snapshotType String
  snapshotData Json
  computedAt   DateTime @default(now())
  expiresAt    DateTime
  isValid      Boolean  @default(true)
  branch       Branch?  @relation(fields: [branchId], references: [id])
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, snapshotType, isValid])
  @@index([tenantId, branchId, snapshotType])
  @@index([expiresAt])
}

model SequenceCounter {
  id           String   @id @default(uuid())
  tenantId     String
  sequenceType String   @db.VarChar(50)
  currentValue BigInt   @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, sequenceType])
  @@index([tenantId])
}

model InventoryDisposal {
  id         String   @id @default(uuid())
  tenantId   String
  branchId   String?
  medicineId String
  batchId    String
  quantity   Int
  reason     String   @default("Expired Stock")
  disposedBy String?
  disposedAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, disposedAt])
  @@index([medicineId])
  @@index([batchId])
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(SUPPORT)
  permissions  String[]
  lastLoginAt  DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  adminUserId String?
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([adminUserId])
  @@index([targetType, targetId])
  @@index([action])
  @@index([createdAt])
}

model AdminDevice {
  id              String    @id @default(uuid())
  shopId          String
  fingerprintHash String
  deviceToken     String?
  browser         String?
  os              String?
  ipAddress       String?
  country         String?
  firstSeen       DateTime  @default(now())
  lastSeen        DateTime  @updatedAt
  riskScore       Int       @default(0)
  isBlocked       Boolean   @default(false)
  blockedAt       DateTime?
  blockedBy       String?
  blockReason     String?

  @@index([shopId])
  @@index([fingerprintHash])
  @@index([ipAddress])
  @@index([riskScore])
  @@index([isBlocked])
}

model AdminFeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(false)
  targetType  String?
  targetIds   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
  @@index([targetType])
}

model SupportTicket {
  id         String                @id @default(uuid())
  tenantId   String
  subject    String
  message    String
  priority   SupportTicketPriority @default(MEDIUM)
  status     SupportTicketStatus   @default(OPEN)
  assignedTo String?
  createdBy  String
  resolvedAt DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
}

model SupportTicketReply {
  id         String   @id @default(uuid())
  ticketId   String
  message    String
  authorId   String
  authorRole String
  createdAt  DateTime @default(now())

  @@index([ticketId])
}

