generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                         String                      @id @default(uuid())
  email                      String                      @unique
  name                       String?
  address                    String?
  gstNumber                  String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  deletedAt                  DateTime?
  aiEnabled                  Boolean                     @default(false)
  maxBranches                Int                         @default(1)
  maxUsers                   Int                         @default(5)
  status                     TenantStatus                @default(ACTIVE)
  whatsappEnabled            Boolean                     @default(false)
  drugLicenseNumber          String?                     @unique
  phone                      String?
  isVerified                 Boolean                     @default(false)
  verifiedAt                 DateTime?
  blacklisted                Boolean                     @default(false)
  blacklistedAt              DateTime?
  blacklistReason            String?
  accessRoles                AccessRole[]
  alertSettings              AlertSettings[]
  alertThresholdOverrides    AlertThresholdOverride[]
  auditLogs                  AuditLog[]
  batchAuditLogs             BatchAuditLog[]
  batchRecalls               BatchRecall[]
  branches                   Branch[]
  cashRegisterSessions       CashRegisterSession[]
  communicationOptOuts       CommunicationOptOut[]
  creditNotes                CreditNote[]
  dailyFinanceSummaries      DailyFinanceSummary[]
  dailyProcurementSummaries  DailyProcurementSummary[]
  dailyPurchaseSummaries     DailyPurchaseSummary[]
  dailySalesSummaries        DailySalesSummary[]
  damagedStock               DamagedStock[]
  dashboardSnapshots         DashboardSnapshot[]
  deadStockAnalyses          DeadStockAnalysis[]
  deliveries                 Delivery[]
  deliveryZones              DeliveryZone[]
  demandForecasts            DemandForecast[]
  doctors                    Doctor[]
  drugAlternatives           DrugAlternative[]
  drugInteractions           DrugInteraction[]
  ecommercePricings          EcommercePricing[]
  escalationPolicies         EscalationPolicy[]
  executiveInsights          ExecutiveInsight[]
  expenses                   Expense[]
  expenseCategories          ExpenseCategory[]
  expiryAlerts               ExpiryAlert[]
  expiryRecommendations      ExpiryRecommendation[]
  expiryRiskPredictions      ExpiryRiskPrediction[]
  fastMovingMedicines        FastMovingMedicine[]
  fileAssets                 FileAsset[]
  forecastRecommendations    ForecastRecommendation[]
  goodsReceiptNotes          GoodsReceiptNote[]
  gstSettings                GstSetting[]
  gstSettingVersions         GstSettingVersion[]
  gstSummaries               GstSummary[]
  hardwareDevices            HardwareDevice[]
  hsnSummaries               HsnSummary[]
  importJobs                 ImportJob[]
  integrationProviders       IntegrationProvider[]
  inventories                Inventory[]
  inventoryBatches           InventoryBatch[]
  inventoryReconciliations   InventoryReconciliation[]
  inventorySyncLogs          InventorySyncLog[]
  invoices                   Invoice[]
  invoiceDeliveryLogs        InvoiceDeliveryLog[]
  invoicePrintJobs           InvoicePrintJob[]
  invoiceTemplateVersions    InvoiceTemplateVersion[]
  journalEntries             JournalEntry[]
  loyaltyTransactions        LoyaltyTransaction[]
  manufacturers              Manufacturer[]
  medicines                  Medicine[]
  medicineBarcodes           MedicineBarcode[]
  categories                 MedicineCategory[]
  medicineInventoryConfigs   MedicineInventoryConfig[]
  medicinePriceHistories     MedicinePriceHistory[]
  medicinePricings           MedicinePricing[]
  medicineStatusHistories    MedicineStatusHistory[]
  medicineSubscriptions      MedicineSubscription[]
  medicineSuppliers          MedicineSupplier[]
  notifications              Notification[]
  notificationChannelConfigs NotificationChannelConfig[]
  notificationRetryLogs      NotificationRetryLog[]
  notificationSettings       NotificationSettings[]
  onlineOrders               OnlineOrder[]
  onlineOrderItems           OnlineOrderItem[]
  outbreakPredictions        OutbreakPrediction[]
  patients                   Patient[]
  patientAdherences          PatientAdherence[]
  patientAdmissions          PatientAdmission[]
  patientAuditLogs           PatientAuditLog[]
  patientBehaviors           PatientBehavior[]
  patientCreditAccounts      PatientCreditAccount[]
  patientCreditLedger        PatientCreditLedger[]
  patientInsuranceClaims     PatientInsuranceClaim[]
  patientLoyaltyAccounts     PatientLoyaltyAccount[]
  patientPrescriptions       PatientPrescription[]
  patientRefills             PatientRefill[]
  patientRefillReminders     PatientRefillReminder[]
  patientReminders           PatientReminder[]
  payments                   Payment[]
  paymentAllocations         PaymentAllocation[]
  paymentMethodAnalytics     PaymentMethodAnalytics[]
  prescriptions              Prescription[]
  providerHealthLogs         ProviderHealthLog[]
  purchaseInvoices           PurchaseInvoice[]
  purchaseOrders             PurchaseOrder[]
  refundPayments             RefundPayment[]
  reminderRules              ReminderRule[]
  returns                    Return[]
  revenueHeatmaps            RevenueHeatmap[]
  revenueSnapshots           RevenueSnapshot[]
  riders                     Rider[]
  sales                      Sale[]
  salesAnomalies             SalesAnomaly[]
  salesReturns               SalesReturn[]
  settings                   Settings?
  settingsApprovals          SettingsApproval[]
  settingsAuditLogs          SettingsAuditLog[]
  shifts                     Shift[]
  slowMovingStocks           SlowMovingStock[]
  smsNotifications           SmsNotification[]
  stockAlerts                StockAlert[]
  stockMovements             StockMovement[]
  stockSnapshots             StockSnapshot[]
  stockTransfers             StockTransfer[]
  storeProfiles              StoreProfile[]
  storeProfileDocuments      StoreProfileDocument[]
  storeProfileLocalizations  StoreProfileLocalization[]
  storeProfileVersions       StoreProfileVersion[]
  subscription               Subscription?
  suppliers                  Supplier[]
  supplierCreditNotes        SupplierCreditNote[]
  supplierLedger             SupplierLedger[]
  supplierPayments           SupplierPayment[]
  supplierPaymentAllocations SupplierPaymentAllocation[]
  supplierReturns            SupplierReturn[]
  tallyExports               TallyExport[]
  tenantBranding             TenantBranding?
  tenantDomains              TenantDomain[]
  tenantSettings             TenantSettings?
  transactions               Transaction[]
  usageMetrics               UsageMetric[]
  users                      User[]
  warehouses                 Warehouse[]
}

model Branch {
  id                        String                    @id @default(uuid())
  tenantId                  String
  name                      String
  code                      String
  phone                     String?
  email                     String?
  address                   String?
  gstNumber                 String?
  deletedAt                 DateTime?
  status                    BranchStatus              @default(ACTIVE)
  alertSettings             AlertSettings[]
  alertThresholdOverrides   AlertThresholdOverride[]
  tenant                    Tenant                    @relation(fields: [tenantId], references: [id])
  branchPerformanceMetrics  BranchPerformanceMetric[]
  cashRegisterSessions      CashRegisterSession[]
  dailyProcurementSummaries DailyProcurementSummary[]
  dailySalesSummaries       DailySalesSummary[]
  dashboardSnapshots        DashboardSnapshot[]
  deadStockAnalyses         DeadStockAnalysis[]
  deliveryZones             DeliveryZone[]
  demandForecasts           DemandForecast[]
  expenses                  Expense[]
  expiryAlerts              ExpiryAlert[]
  expiryRiskPredictions     ExpiryRiskPrediction[]
  fastMovingMedicines       FastMovingMedicine[]
  gstSettings               GstSetting[]
  hardwareDevices           HardwareDevice[]
  integrationProviders      IntegrationProvider[]
  inventories               Inventory[]
  inventoryBatches          InventoryBatch[]
  inventoryReconciliations  InventoryReconciliation[]
  invoices                  Invoice[]
  inventoryConfigs          MedicineInventoryConfig[]
  onlineOrders              OnlineOrder[]
  payments                  Payment[]
  paymentMethodAnalytics    PaymentMethodAnalytics[]
  purchaseOrders            PurchaseOrder[]
  returns                   Return[]
  revenueHeatmaps           RevenueHeatmap[]
  sales                     Sale[]
  settingsAuditLogs         SettingsAuditLog[]
  slowMovingStocks          SlowMovingStock[]
  stockAlerts               StockAlert[]
  stockMovements            StockMovement[]
  destTransfers             StockTransfer[]           @relation("DestBranch")
  sourceTransfers           StockTransfer[]           @relation("SourceBranch")
  storeProfiles             StoreProfile[]
  storeProfileDocuments     StoreProfileDocument[]
  users                     User[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model User {
  id                           String                     @id @default(uuid())
  email                        String                     @unique
  password                     String
  fullName                     String
  role                         Role                       @default(OWNER)
  tenantId                     String
  branchId                     String?
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
  deletedAt                    DateTime?
  avatar                       String?
  phone                        String?
  username                     String?
  pharmacistRegistrationNumber String?
  resetOtp                     String?
  resetOtpAttempts             Int                        @default(0)
  resetOtpExpiry               DateTime?
  resetOtpLastSentAt           DateTime?
  resetOtpVerified             Boolean                    @default(false)
  resetToken                   String?
  resetTokenExpiry             DateTime?
  roleId                       String?
  avatarData                   Bytes?
  avatarMimeType               String?
  status                       UserStatus                 @default(ACTIVE)
  blockedAt                    DateTime?
  blockedReason                String?
  alertSettings                AlertSettings[]
  auditLogs                    AuditLog[]
  batchAuditLogs               BatchAuditLog[]
  browserLock                  BrowserLock?
  cashRegisterSessions         CashRegisterSession[]
  creditNotes                  CreditNote[]
  devices                      Device[]
  expenses                     Expense[]
  fileAssets                   FileAsset[]
  receivedGRNs                 GoodsReceiptNote[]
  importJobs                   ImportJob[]
  invoices                     Invoice[]
  invoiceAuditLogs             InvoiceAuditLog[]
  medicines                    Medicine[]
  inventoryConfigs             MedicineInventoryConfig[]  @relation("ConfigUpdater")
  priceHistory                 MedicinePriceHistory[]     @relation("PriceChanger")
  statusHistory                MedicineStatusHistory[]    @relation("StatusChanger")
  mobileDevices                MobileDevice[]
  notifications                Notification[]
  notificationPreferences      NotificationPreference[]
  otpAuditLogs                 OtpAuditLog[]
  prescriptions                Prescription[]
  prescriptionVerifications    PrescriptionVerification[]
  approvedPurchaseOrders       PurchaseOrder[]            @relation("POApprover")
  purchaseOrders               PurchaseOrder[]
  purchaseOrderApprovals       PurchaseOrderApproval[]
  refreshTokens                RefreshToken[]
  refundPayments               RefundPayment[]
  returns                      Return[]
  sales                        Sale[]
  salesReturns                 SalesReturn[]
  approvedApprovals            SettingsApproval[]         @relation("ApprovalApprover")
  proposedApprovals            SettingsApproval[]         @relation("ApprovalProposer")
  settingsAuditLogs            SettingsAuditLog[]
  shifts                       Shift[]
  stockMovements               StockMovement[]
  supplierPayments             SupplierPayment[]
  approvedSupplierReturns      SupplierReturn[]           @relation("SupplierReturnApprover")
  createdSupplierReturns       SupplierReturn[]           @relation("SupplierReturnCreator")
  transactions                 Transaction[]
  branch                       Branch?                    @relation(fields: [branchId], references: [id])
  assignedRole                 AccessRole?                @relation(fields: [roleId], references: [id])
  tenant                       Tenant                     @relation(fields: [tenantId], references: [id])
  userSessions                 UserSession[]

  @@index([tenantId])
}

model OtpAuditLog {
  id         String    @id @default(uuid())
  userId     String?
  email      String
  otp        String?
  purpose    String
  status     String    @default("GENERATED")
  channel    String?
  ipAddress  String?
  expiresAt  DateTime?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([email, createdAt])
  @@index([purpose])
  @@index([status])
}

model AlertSettings {
  id                     String                   @id @default(uuid())
  tenantId               String
  branchId               String?                  @db.VarChar(255)
  lowStockThreshold      Int                      @default(20)
  criticalStockThreshold Int                      @default(5)
  expiryWarningDays      Int                      @default(30)
  criticalExpiryDays     Int                      @default(7)
  autoRaisePO            Boolean                  @default(false)
  escalationHours        Int                      @default(24)
  updatedBy              String?                  @db.VarChar(255)
  updatedAt              DateTime                 @default(now()) @updatedAt
  createdAt              DateTime                 @default(now())
  userId                 String?
  branch                 Branch?                  @relation(fields: [branchId], references: [id])
  tenant                 Tenant                   @relation(fields: [tenantId], references: [id])
  user                   User?                    @relation(fields: [userId], references: [id])
  overrides              AlertThresholdOverride[]

  @@unique([tenantId, branchId])
  @@index([tenantId])
}

model AlertThresholdOverride {
  id                     String        @id @default(uuid())
  tenantId               String
  alertSettingsId        String
  medicineId             String
  lowStockThreshold      Int?
  criticalStockThreshold Int?
  expiryWarningDays      Int?
  criticalExpiryDays     Int?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  branchId               String?
  alertSettings          AlertSettings @relation(fields: [alertSettingsId], references: [id], onDelete: Cascade)
  branch                 Branch?       @relation(fields: [branchId], references: [id])
  medicine               Medicine      @relation(fields: [medicineId], references: [id])
  tenant                 Tenant        @relation(fields: [tenantId], references: [id])

  @@unique([alertSettingsId, medicineId])
  @@index([tenantId])
  @@index([medicineId])
}

model Settings {
  id                   String  @id @default(uuid())
  tenantId             String  @unique
  lowStock             Int     @default(10)
  expiryDays           Int     @default(30)
  theme                String  @default("dark")
  autoEscalation       Boolean @default(true)
  auditLogging         Boolean @default(false)
  inventorySettings    Json?
  billingSettings      Json?
  taxSettings          Json?
  notificationSettings Json?
  loyaltySettings      Json?
  securitySettings     Json?
  storeProfile         Json?
  integrations         Json?
  invoiceTemplate      Json?
  alertThresholds      Json?
  tenant               Tenant  @relation(fields: [tenantId], references: [id])
}

model SubscriptionPlan {
  id            String         @id @default(uuid())
  name          String
  price         Decimal        @db.Decimal(12, 2)
  features      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  billingCycle  BillingCycle   @default(MONTHLY)
  subscriptions Subscription[]
}

model Subscription {
  id                     String             @id @default(uuid())
  tenantId               String             @unique
  planId                 String
  status                 SubscriptionStatus @default(TRIAL)
  startDate              DateTime?
  endDate                DateTime?
  graceEndDate           DateTime?
  autoRenew              Boolean            @default(false)
  paymentProvider        String?            @default("razorpay")
  externalSubscriptionId String?            @unique
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  plan                   SubscriptionPlan   @relation(fields: [planId], references: [id])
  tenant                 Tenant             @relation(fields: [tenantId], references: [id])
}

model Payment {
  id                   String              @id @default(uuid())
  transactionId        String              @unique
  tenantId             String
  amount               Decimal             @db.Decimal(12, 2)
  currency             String              @default("INR")
  status               PaymentStatus       @default(PENDING)
  paymentProvider      String?
  razorpayPaymentId    String?
  razorpayOrderId      String?
  refundId             String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  branchId             String?
  correlationId        String?
  failureReason        String?
  idempotencyKey       String?
  idempotencyKeyHash   String?             @unique
  lastRecoveryAt       DateTime?
  paidAt               DateTime?
  paymentMethod        String?
  razorpaySignature    String?
  retryCount           Int                 @default(0)
  transactionReference String?
  branch               Branch?             @relation(fields: [branchId], references: [id])
  tenant               Tenant              @relation(fields: [tenantId], references: [id])
  allocations          PaymentAllocation[]
  auditLogs            PaymentAuditLog[]

  @@index([tenantId])
  @@index([branchId])
  @@index([razorpayOrderId])
  @@index([status])
  @@index([idempotencyKeyHash])
  @@index([correlationId])
  @@index([createdAt])
}

model PaymentAllocation {
  id              String   @id @default(uuid())
  tenantId        String
  paymentId       String
  invoiceId       String
  allocatedAmount Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  payment         Payment  @relation(fields: [paymentId], references: [id])
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@index([paymentId])
  @@index([invoiceId])
  @@index([tenantId])
}

model Transaction {
  id              String            @id @default(uuid())
  tenantId        String
  userId          String
  amount          Decimal           @db.Decimal(12, 2)
  currency        String            @default("INR")
  razorpayOrderId String            @unique
  paymentId       String?
  receipt         String?
  status          TransactionStatus @default(PENDING)
  refundId        String?
  idempotencyKey  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  correlationId   String?
  gatewayResponse Json?
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  user            User              @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([correlationId])
  @@index([idempotencyKey])
  @@index([status])
}

model PaymentIdempotency {
  id             String    @id @default(uuid())
  idempotencyKey String    @unique
  response       Json
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?

  @@index([expiresAt])
}

model PaymentAuditLog {
  id         String   @id @default(uuid())
  paymentId  String
  tenantId   String
  fromStatus String
  toStatus   String
  transition String
  metadata   Json?
  createdAt  DateTime @default(now())
  payment    Payment  @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([tenantId])
  @@index([createdAt])
}

model PaymentWebhook {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique
  event          String
  payload        Json
  signature      String?
  processedAt    DateTime @default(now())

  @@index([event])
  @@index([processedAt])
}

model PaymentRecovery {
  id           String    @id @default(uuid())
  paymentId    String
  tenantId     String
  recoveryType String
  fromStatus   String
  toStatus     String
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5)
  lastError    String?
  recoveredAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([paymentId])
  @@index([tenantId])
  @@index([recoveryType])
}

model PaymentReconciliation {
  id              String   @id @default(uuid())
  tenantId        String
  matchedCount    Int      @default(0)
  healedCount     Int      @default(0)
  mismatchedCount Int      @default(0)
  failedCount     Int      @default(0)
  details         Json?
  reconciledAt    DateTime @default(now())

  @@index([tenantId])
  @@index([reconciledAt])
}

model MedicineCategory {
  id          String             @id @default(uuid())
  tenantId    String
  name        String
  description String?
  parentId    String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  medicines   Medicine[]
  parent      MedicineCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    MedicineCategory[] @relation("CategoryHierarchy")
  tenant      Tenant             @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
}

model Manufacturer {
  id            String     @id @default(uuid())
  tenantId      String
  name          String
  contactEmail  String?
  phone         String?
  address       String?
  licenseNumber String?
  gstNumber     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  medicines     Medicine[]

  @@unique([tenantId, name])
}

model Medicine {
  id                       String                     @id @default(uuid())
  tenantId                 String
  userId                   String?
  name                     String
  genericName              String?
  categoryId               String?
  manufacturerId           String?
  barcode                  String?
  sku                      String?                    @unique
  hsnCode                  String?
  dosageForm               String?
  strength                 String?
  gstPercentage            Float                      @default(0)
  reorderLevel             Int                        @default(10)
  description              String?
  prescriptionRequired     Boolean                    @default(false)
  isActive                 Boolean                    @default(true)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  deletedAt                DateTime?
  isPublished              Boolean                    @default(false)
  onlineDescription        String?
  scheduleType             String?
  composition              String?
  imageUrl                 String?
  reorderQuantity          Int?
  status                   MedicineStatus             @default(ACTIVE)
  storageCondition         String?
  unit                     String?
  packagingType            String?
  alertThresholdOverrides  AlertThresholdOverride[]
  barcodeMappings          BarcodeMapping[]
  deadStockAnalyses        DeadStockAnalysis[]
  demandForecasts          DemandForecast[]
  asAlternative            DrugAlternative[]          @relation("AlternativeToMedicine")
  alternatives             DrugAlternative[]          @relation("MedicineToAlternative")
  asInteraction            DrugInteraction[]          @relation("InteractionToMedicine")
  interactions             DrugInteraction[]          @relation("MedicineToInteraction")
  ecommercePricing         EcommercePricing[]
  expiryAlerts             ExpiryAlert[]
  expiryRiskPredictions    ExpiryRiskPrediction[]
  fastMovingMedicines      FastMovingMedicine[]
  goodsReceiptNoteItems    GoodsReceiptNoteItem[]
  importItems              ImportExtractedItem[]
  inpatientMedicationUsage InpatientMedicationUsage[]
  inventory                Inventory[]
  inventoryBatches         InventoryBatch[]
  inventoryReconciliations InventoryReconciliation[]
  inventorySyncLogs        InventorySyncLog[]
  invoiceItems             InvoiceItem[]
  category                 MedicineCategory?          @relation(fields: [categoryId], references: [id])
  manufacturer             Manufacturer?              @relation(fields: [manufacturerId], references: [id])
  tenant                   Tenant                     @relation(fields: [tenantId], references: [id])
  user                     User?                      @relation(fields: [userId], references: [id])
  medicineBarcodes         MedicineBarcode[]
  inventoryConfigs         MedicineInventoryConfig[]
  priceHistory             MedicinePriceHistory[]
  pricingMaster            MedicinePricing[]
  statusHistory            MedicineStatusHistory[]
  medicineSubscriptions    MedicineSubscription[]
  supplierItems            MedicineSupplier[]
  onlineOrderItems         OnlineOrderItem[]
  patientBehaviors         PatientBehavior[]
  patientRefills           PatientRefill[]
  patientReminders         PatientReminder[]
  prescriptionItems        PrescriptionItem[]
  purchaseOrderItems       PurchaseOrderItem[]
  returnItems              ReturnItem[]
  saleItems                SaleItem[]
  slowMovingStocks         SlowMovingStock[]
  stockAlerts              StockAlert[]
  stockMovements           StockMovement[]
  stockSnapshots           StockSnapshot[]
  supplierReturns          SupplierReturn[]
  supplierReturnItems      SupplierReturnItem[]

  @@unique([tenantId, barcode])
  @@index([tenantId, name])
  @@index([tenantId, barcode])
  @@index([tenantId, genericName])
  @@index([tenantId, sku])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@index([tenantId, dosageForm])
  @@index([tenantId, scheduleType])
  @@index([tenantId, deletedAt])
  @@index([tenantId, deletedAt, isActive])
  @@index([tenantId, isActive])
}

model MedicinePricing {
  id            String   @id @default(uuid())
  tenantId      String
  medicineId    String
  mrp           Decimal  @db.Decimal(12, 2)
  purchasePrice Decimal  @db.Decimal(12, 2)
  sellingPrice  Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime @default(now())
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  medicine      Medicine @relation(fields: [medicineId], references: [id])
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, medicineId])
}

model DrugInteraction {
  id              String   @id @default(uuid())
  tenantId        String
  medicineId      String
  interactsWithId String
  severity        String
  description     String?
  createdAt       DateTime @default(now())
  interactsWith   Medicine @relation("InteractionToMedicine", fields: [interactsWithId], references: [id])
  medicine        Medicine @relation("MedicineToInteraction", fields: [medicineId], references: [id])
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([medicineId, interactsWithId])
  @@index([tenantId])
}

model DrugAlternative {
  id            String   @id @default(uuid())
  tenantId      String
  medicineId    String
  alternativeId String
  matchScore    Float    @default(0)
  createdAt     DateTime @default(now())
  alternative   Medicine @relation("AlternativeToMedicine", fields: [alternativeId], references: [id])
  medicine      Medicine @relation("MedicineToAlternative", fields: [medicineId], references: [id])
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([medicineId, alternativeId])
  @@index([tenantId])
}

model EcommercePricing {
  id                 String    @id @default(uuid())
  tenantId           String
  medicineId         String
  onlinePrice        Decimal   @db.Decimal(12, 2)
  discountPercentage Float     @default(0)
  effectiveFrom      DateTime  @default(now())
  effectiveTo        DateTime?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  medicine           Medicine  @relation(fields: [medicineId], references: [id])
  tenant             Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, medicineId])
}

model InventorySyncLog {
  id           String     @id @default(uuid())
  tenantId     String
  medicineId   String
  sourceSystem String     @db.VarChar(100)
  errorMessage String?
  syncedAt     DateTime?
  createdAt    DateTime   @default(now())
  syncStatus   SyncStatus @default(PENDING)
  medicine     Medicine   @relation(fields: [medicineId], references: [id])
  tenant       Tenant     @relation(fields: [tenantId], references: [id])

  @@index([tenantId, syncStatus])
}

model Inventory {
  id              String          @id @default(uuid())
  tenantId        String
  branchId        String?         @db.VarChar(255)
  medicineId      String
  currentStock    Int             @default(0)
  reservedStock   Int             @default(0)
  reorderPoint    Int             @default(10)
  reorderQuantity Int             @default(50)
  minimumStock    Int             @default(5)
  maximumStock    Int             @default(500)
  status          InventoryStatus @default(HEALTHY)
  rackLocation    String?
  lastAuditAt     DateTime?
  updatedAt       DateTime        @updatedAt
  createdAt       DateTime        @default(now())
  branch          Branch?         @relation(fields: [branchId], references: [id])
  medicine        Medicine        @relation(fields: [medicineId], references: [id])
  tenant          Tenant          @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, branchId, medicineId])
  @@index([medicineId])
  @@index([tenantId, branchId, status])
  @@index([tenantId, branchId, currentStock])
}

model InventoryBatch {
  id                    String                 @id @default(uuid())
  medicineId            String
  branchId              String?                @db.VarChar(255)
  batchNumber           String                 @db.VarChar(100)
  barcode               String?                @db.VarChar(100)
  quantity              Int                    @default(0)
  reservedQuantity      Int                    @default(0)
  expiryDate            DateTime               @db.Date
  manufacturingDate     DateTime?              @db.Date
  purchasePrice         Decimal                @default(0) @db.Decimal(12, 2)
  sellingPrice          Decimal                @default(0) @db.Decimal(12, 2)
  mrp                   Decimal                @default(0) @db.Decimal(12, 2)
  rackLocation          String?                @db.VarChar(100)
  supplierId            String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  recalled              Boolean                @default(false)
  availableQuantity     Int                    @default(0)
  purchaseOrderItemId   String?
  recallReason          String?
  receivedQuantity      Int                    @default(0)
  storageType           BatchStorageType       @default(NORMAL)
  tenantId              String
  status                BatchStatus            @default(ACTIVE)
  purchaseInvoiceId     String?
  receivedDate          DateTime?
  auditLogs             BatchAuditLog[]
  damagedRecords        DamagedStock[]
  expiryAlerts          ExpiryAlert[]
  expiryRecommendations ExpiryRecommendation[]
  expiryRiskPredictions ExpiryRiskPrediction[]
  branch                Branch?                @relation(fields: [branchId], references: [id])
  medicine              Medicine               @relation(fields: [medicineId], references: [id])
  purchaseInvoice       PurchaseInvoice?       @relation(fields: [purchaseInvoiceId], references: [id])
  purchaseOrderItem     PurchaseOrderItem?     @relation(fields: [purchaseOrderItemId], references: [id])
  supplier              Supplier?              @relation(fields: [supplierId], references: [id])
  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  invoiceItems          InvoiceItem[]
  medicineBarcodes      MedicineBarcode[]
  onlineOrderItems      OnlineOrderItem[]
  quarantineRecords     QuarantinedBatch[]
  returnItems           ReturnItem[]
  saleItems             SaleItem[]
  salesReturns          SalesReturn[]
  stockMovements        StockMovement[]
  transferItems         StockTransferItem[]
  supplierReturns       SupplierReturn[]
  supplierReturnItems   SupplierReturnItem[]

  @@unique([tenantId, branchId, medicineId, batchNumber])
  @@index([expiryDate])
  @@index([status])
  @@index([tenantId, branchId, medicineId, status, expiryDate], map: "idx_batch_fefo")
  @@index([tenantId, deletedAt])
  @@index([tenantId, status, expiryDate])
  @@index([tenantId, branchId, quantity, expiryDate])
  @@index([barcode])
}

model BatchAuditLog {
  id          String         @id @default(uuid())
  tenantId    String
  batchId     String
  actionType  String
  beforeState Json?
  afterState  Json?
  performedBy String?
  reason      String?
  notes       String?
  ipAddress   String?        @db.VarChar(45)
  userAgent   String?
  performedAt DateTime       @default(now())
  batch       InventoryBatch @relation(fields: [batchId], references: [id])
  user        User?          @relation(fields: [performedBy], references: [id])
  tenant      Tenant         @relation(fields: [tenantId], references: [id])

  @@index([batchId])
  @@index([tenantId])
}

model StockMovement {
  id             String          @id @default(uuid())
  tenantId       String
  branchId       String?
  medicineId     String
  batchId        String?
  movementType   MovementType
  quantity       Int
  quantityBefore Int?
  quantityAfter  Int?
  referenceType  String?
  referenceId    String?
  idempotencyKey String?         @unique
  performedBy    String?
  notes          String?
  createdAt      DateTime        @default(now())
  batch          InventoryBatch? @relation(fields: [batchId], references: [id])
  branch         Branch?         @relation(fields: [branchId], references: [id])
  medicine       Medicine        @relation(fields: [medicineId], references: [id])
  user           User?           @relation(fields: [performedBy], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([medicineId, createdAt])
  @@index([batchId])
}

model StockSnapshot {
  id           String   @id @default(uuid())
  tenantId     String
  medicineId   String
  openingStock Int
  closingStock Int
  snapshotDate DateTime @db.Date
  createdAt    DateTime @default(now())
  medicine     Medicine @relation(fields: [medicineId], references: [id])
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, medicineId, snapshotDate])
}

model StockAlert {
  id              String         @id @default(uuid())
  tenantId        String
  medicineId      String
  type            StockAlertType
  message         String
  isResolved      Boolean        @default(false)
  resolvedAt      DateTime?
  snoozedUntil    DateTime?
  createdAt       DateTime       @default(now())
  acknowledgedAt  DateTime?
  acknowledgedBy  String?
  alertStatus     AlertStatus    @default(ACTIVE)
  branchId        String?
  currentStock    Int            @default(0)
  daysRemaining   Int?
  escalatedAt     DateTime?
  escalationCount Int            @default(0)
  purchaseOrderId String?
  resolutionNote  String?
  resolvedBy      String?
  severity        String         @default("INFO")
  snoozeReason    String?
  snoozedBy       String?
  thresholdValue  Int?
  updatedAt       DateTime       @updatedAt
  branch          Branch?        @relation(fields: [branchId], references: [id])
  medicine        Medicine       @relation(fields: [medicineId], references: [id])
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  tenant          Tenant         @relation(fields: [tenantId], references: [id])

  @@index([tenantId, alertStatus])
  @@index([tenantId, isResolved])
  @@index([branchId, alertStatus])
  @@index([severity, alertStatus])
  @@index([snoozedUntil])
}

model ExpiryAlert {
  id                String         @id @default(uuid())
  tenantId          String
  batchId           String
  medicineId        String
  severity          String         @default("INFO")
  daysRemaining     Int
  createdAt         DateTime       @default(now())
  acknowledgedAt    DateTime?
  acknowledgedBy    String?
  alertStatus       AlertStatus    @default(ACTIVE)
  branchId          String?
  escalatedAt       DateTime?
  escalationCount   Int            @default(0)
  isResolved        Boolean        @default(false)
  potentialLoss     Decimal?       @db.Decimal(12, 2)
  recommendedAction String?
  resolvedAt        DateTime?
  resolvedBy        String?
  snoozeReason      String?
  snoozedUntil      DateTime?
  updatedAt         DateTime       @updatedAt
  batch             InventoryBatch @relation(fields: [batchId], references: [id])
  branch            Branch?        @relation(fields: [branchId], references: [id])
  medicine          Medicine       @relation(fields: [medicineId], references: [id])
  tenant            Tenant         @relation(fields: [tenantId], references: [id])

  @@index([tenantId, alertStatus])
  @@index([tenantId, isResolved])
  @@index([branchId, alertStatus])
  @@index([severity, alertStatus])
  @@index([daysRemaining])
}

model ExpiryRecommendation {
  id            String         @id @default(uuid())
  tenantId      String
  batchId       String
  type          String
  priorityScore Float
  message       String
  createdAt     DateTime       @default(now())
  batch         InventoryBatch @relation(fields: [batchId], references: [id])
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
}

model QuarantinedBatch {
  id            String         @id @default(uuid())
  batchId       String
  reason        String?
  quarantinedBy String?
  createdAt     DateTime       @default(now())
  batch         InventoryBatch @relation(fields: [batchId], references: [id])
}

model DamagedStock {
  id         String         @id @default(uuid())
  tenantId   String
  batchId    String
  quantity   Int
  reason     String?
  reportedBy String?
  createdAt  DateTime       @default(now())
  batch      InventoryBatch @relation(fields: [batchId], references: [id])
  tenant     Tenant         @relation(fields: [tenantId], references: [id])
}

model StockTransfer {
  id                  String              @id @default(uuid())
  tenantId            String
  sourceBranchId      String
  destinationBranchId String
  transferNumber      String
  status              StockTransferStatus @default(PENDING)
  initiatedBy         String?
  approvedBy          String?
