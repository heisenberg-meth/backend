# ──────────────────────────────────────────────────────────────
# Viyan MedAssist — Backend Environment Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.

# ── Server Configuration ──────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── JWT Configuration ─────────────────────────────────────────
# Use a strong, random secret. Minimum 32 characters recommended.
JWT_SECRET=viyan_medassist_secure_dev_2024_change_this_in_production
# For token rotation: comma-separated list (first is active)
# JWT_SECRETS=secret1,secret2,secret3

# ── CORS Configuration ────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://your-production-app.com

# ── Frontend URL (for email links, redirects) ─────────────────
FRONTEND_URL=http://localhost:5173

# ── PostgreSQL Configuration (Prisma) ─────────────────────────
DATABASE_URL=postgresql://viyan_user:viyan_password@localhost:5432/viyan_db?schema=public

# ── Redis Configuration ───────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── RabbitMQ Configuration ────────────────────────────────────
# If running backend NATIVELY (node server.js): use localhost
# If running backend in DOCKER: use rabbitmq (the container name)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
ENABLE_EVENTBUS=true

# ── Security ──────────────────────────────────────────────────
COOKIE_SECRET=your_cookie_secret_here_minimum_32_chars

# ── Razorpay Configuration ────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# ── Email Configuration (Nodemailer) ──────────────────────────
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# ── Cloudinary Configuration (Avatar Uploads) ─────────────────
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# ── AWS S3 Configuration (Optional) ───────────────────────────
AWS_BUCKET_NAME=...
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=debug
