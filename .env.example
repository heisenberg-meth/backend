# Environment Variables Example
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql://xxxxxxxxxxxxxxxxxxxxxxxxxxxxx/med_assist_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT & Security
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
COOKIE_SECRET=your-cookie-secret-min-10-chars
ENCRYPTION_KEY=your-64-character-hex-encryption-key-for-data-at-rest

# Razorpay (for payments)
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Media Base URL (for generating public HTTPS image URLs)
MEDIA_BASE_URL=https://api.medassist.com

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# App Config
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# AWS (optional - for file uploads)
AWS_BUCKET_NAME=your-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx

# Cloudinary (optional - for image uploads)
CLOUDINARY_CLOUD_NAME=xxxxx
CLOUDINARY_API_KEY=xxxxx
CLOUDINARY_API_SECRET=xxxxx

# Sentry (optional - for error tracking)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
